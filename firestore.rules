rules_version = '2';
// Κανόνες ασφαλείας: μόνο τα τρία μέλη της οικογένειας διαβάζουν/γράφουν.
// Επικόλληση: Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email in [
          '***',
          '***',
          '***'
        ];
    }
    match /family/{rest=**} {
      allow read, write: if isFamily();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
